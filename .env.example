# Copy to .env.local and fill in what you need. Everything is optional in development.

# Public URL of the app, for share links, link previews and SMS autofill.
# Optional: defaults to the request's own address (and Vercel's production domain for previews).
# APP_URL=https://trove.example.com

# Signs login codes. Optional: if unset, a random one is generated and stored in the database.
# AUTH_SECRET=

# Database. Defaults to a local SQLite file (data/shelf.db).
# For hosting, point at a Turso/libSQL database (Vercel's Turso integration sets the TURSO_* pair):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Texting login codes (Twilio). Without these, dev mode shows the code on screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or instead of TWILIO_FROM:
# TWILIO_MESSAGING_SERVICE_SID=

# Emailing login codes (Resend). Without these, dev mode shows the code on screen.
RESEND_API_KEY=
EMAIL_FROM="Trove <login@yourdomain.com>"

# Until Twilio/Resend is connected: let these phone numbers (+ and country code) and emails sign in
# in production, with their codes written to the server log (Vercel → Logs) instead of sent.
# "1" shows every code on screen, so anyone can sign in as anyone: throwaway demos only.
# ALLOW_DEV_CODES=+14155550123,me@example.com

# Book catalog. Open Library needs no key. Google Books is the fallback;
# its keyless quota is shared and often exhausted, so add a key if you rely on it.
GOOGLE_BOOKS_API_KEY=
# BOOKS_PROVIDER=fixture   # offline mode: small built-in catalogs for every collection (used by tests)

# Podcasts come from Apple's podcast directory (no key). Movies & TV come from iTunes and TVmaze
# (no key); a free TMDB key (themoviedb.org → Settings → API, v3 key or v4 read token) gives
# better matches and posters.
TMDB_API_KEY=

# Places search uses OpenStreetMap (Photon, no key). Google Places (New) gives better restaurant and
# shop results: enable "Places API (New)" in Google Cloud and paste a key here.
GOOGLE_PLACES_API_KEY=

# Reading photos and screenshots (a bookshelf, a podcast app, a watchlist) turns on when this is set.
ANTHROPIC_API_KEY=

# Who runs this Trove: phone numbers (+ and country code) or emails, comma-separated. They can read feedback at /feedback.
# OWNERS=+14155550123
# Also email each piece of feedback here (needs RESEND_API_KEY and EMAIL_FROM).
# FEEDBACK_EMAIL=you@example.com
