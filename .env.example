# Copy to .env.local and fill in what you need. Everything is optional in development.

# Public URL of the app, for share links, link previews and SMS autofill.
# Optional: defaults to the request's own address (and Vercel's production domain for previews).
# APP_URL=https://shelf.example.com

# Signs login codes. Optional: if unset, a random one is generated and stored in the database.
# AUTH_SECRET=

# Database. Defaults to a local SQLite file (data/shelf.db).
# For hosting, point at a Turso/libSQL database (Vercel's Turso integration sets the TURSO_* pair):
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Texting login codes (Twilio). Without these, dev mode shows the code on screen.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# or instead of TWILIO_FROM:
# TWILIO_MESSAGING_SERVICE_SID=

# Emailing login codes (Resend). Without these, dev mode shows the code on screen.
RESEND_API_KEY=
EMAIL_FROM="Shelf <login@yourdomain.com>"

# Show codes on screen in production for these phone numbers (with country code) and emails,
# until Twilio/Resend is connected. "1" allows anyone: private demos only.
# ALLOW_DEV_CODES=+14155550123,me@example.com

# Book catalog. Open Library needs no key. Google Books is the fallback;
# its keyless quota is shared and often exhausted, so add a key if you rely on it.
GOOGLE_BOOKS_API_KEY=
# BOOKS_PROVIDER=fixture   # offline mode: a small built-in catalog (used by tests)

# "Snap your shelf" (read books from a photo) turns on when this is set.
ANTHROPIC_API_KEY=
